# Secrets
.env
cloudflared/credentials.json
# miniflux-ai config holds the Miniflux API key and the LLM provider key —
# the committed template is miniflux-ai/config.example.yml
miniflux-ai/config.yml

# Private keys
*.key
*.pem
*.p12
*.pfx

# Python bytecode — build artefacts, never source
__pycache__/
*.py[cod]

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Backup files
*.bak

# Log files
*.log
*.log.old

# Portainer — runtime data and keys
portainer/data/

# Homarr — runtime database and generated config
homarr/data/

# Uptime Kuma — runtime database
uptime-kuma/data/

# Obsidian — entire runtime config (cookies, session, cache, certs)
obsidian/config/
obsidian/vaults/

# Grafana — persistent data volume (managed by Docker)
grafana/data/

# Claude desktop — browser profile and session data
claude-code/config/

# Daily notes
senya-daily/data

# Authelia — runtime state (the config files themselves are kept in git)
authelia/db.sqlite3
authelia/notification.txt
# Vaultwarden — vault database, attachments, keys (NEVER commit)
vaultwarden/data/

# Obsidian LiveSync CouchDB — database files
obsidian-couchdb/data/

# LiveSync Bridge — replicator state + decoded vault files (and any runtime config)
livesync-bridge/data/
livesync-bridge/dat/

# Finance app — SQLite database
senya-finance/data/

# WebDAV — synced Boox notes/files (not config)
webdav/data/

# Nextcloud — both paths are bind mounts the container populates itself, so
# there is nothing hand-written to keep. html/ is the unpacked Nextcloud app
# (~1GB, reinstalled from the pinned image) and data/ is user files plus
# config/config.php, which holds the DB password and instance secret.
# The Postgres volume is the named `nextcloud-db`, already outside the repo.
nextcloud/html/
nextcloud/data/
